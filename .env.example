# Server
PORT=3000

# Anthropic API Key (required)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Workspace (where repos are cloned)
WORKSPACE_ROOT=/app/workspaces

# Demo template (optional, for quick start feature)
# Clone your demo repo here: git clone <url> ./demo-templates/askcode-demo
DEMO_TEMPLATE_PATH=./demo-templates/askcode-demo

# Supabase (required for auth and data persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Client-side Supabase (same values as above, exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Database URL (optional, for automatic migrations)
# Find it in Supabase Dashboard > Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
