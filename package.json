{
  "name": "askcode",
  "version": "0.1.0",
  "type": "module",
  "description": "AI-powered codebase Q&A for non-developers",
  "scripts": {
    "dev": "node scripts/migrate.cjs && next dev -p 3010",
    "build": "next build && cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public 2>/dev/null || true",
    "start": "node scripts/migrate.cjs && node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate.cjs",
    "worker": "tsx src/server/worker.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@octokit/auth-app": "^8.1.2",
    "@supabase/supabase-js": "^2.47.0",
    "dompurify": "^3.4.2",
    "dotenv": "^16.4.5",
    "glob": "^13.0.6",
    "marked": "^15.0.7",
    "next": "16.2.6",
    "octokit": "^5.0.5",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "simple-git": "^3.36.0",
    "tsx": "^4.20.6",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  }
}
